<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_ai_chatbot_new" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ai.chatbot</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form[hasclass('oe_form_configuration')]" position="inside">
                <div class="app_settings_block" data-string="AI Chatbot" string="AI Chatbot" data-key="ai_chatbot_new">
                    <h2>AI Chatbot</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="ai_chatbot_new_model" string="Model"/>
                                <div class="text-muted">
                                    Provider
                                </div>
                                <field name="ai_chatbot_provider"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="ai_chatbot_new_api_key" string="API Key"/>
                                <div class="text-muted">
                                    API key for your LLM provider.
                                </div>
                                <field name="ai_chatbot_new_api_key" password="True"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="ai_chatbot_new_api_url" string="API URL"/>
                                <div class="text-muted">
                                    Chat completions endpoint (OpenAI-compatible).
                                </div>
                                <field name="ai_chatbot_new_api_url"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="ai_chatbot_new_model" string="Model"/>
                                <div class="text-muted">
                                    Model name to request, e.g. gpt-4o-mini.
                                </div>
                                <field name="ai_chatbot_new_model"/>
                            </div>
                        </div>
                        
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
